[Unit]
Description=vLLM pooling server - Qwen3-Embedding-8B (dense baseline)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
Environment=HF_HUB_OFFLINE=0
ExecStart=__VLLM__ serve Qwen/Qwen3-Embedding-8B \
  --served-model-name qwen3-emb \
  --runner pooling \
  --no-enable-chunked-prefill --max-num-batched-tokens 8192 \
  --max-model-len 8192 \
  --dtype bfloat16 \
  --gpu-memory-utilization 0.2 \
  --host 0.0.0.0 --port 8091
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
